{
  "theme": "base",
  "securityLevel": "loose",
  "htmlLabels": false,
  "fontFamily": "Arial, sans-serif",
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "fontSize": "18px",
    "lineColor": "#63798e",
    "background": "#ffffff",
    "primaryTextColor": "#17324f"
  },
  "flowchart": {
